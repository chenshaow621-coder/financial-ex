MERGE (a:BusinessAtom {id: 'YZ-GEN-OBL-01783'}) SET a += {rule_type: 'OBL_MANDATORY', article_reference: '第十一条', who: '证券公司、期货公司、基金管理公司以及其他从事基金销售业务的机构', who_terms: ['证券公司、期货公司、基金管理公司以及其他从事基金销售业务的机构', '证券公司', '期货公司', '基金管理公司以', '其他从事基金销售业务的机构'], what: '客户身份、实际控制客户的自然人、交易的实际受益人、客户有效身份证件或其他身份证明文件、客户身份基本信息', how: '识别、了解、核对、登记、留存复印件或影印件', where: '客户身份识别与业务办理环节', content_original: '证券公司、期货公司、基金管理公司以及其他从事基金销售业务的机构在办理以下业务时，应当识别客户身份，了解实际控制客户的自然人和交易的实际受益人，核对客户的有效身份证件或者其他身份证明文件，登记客户身份基本信息，并留存有效身份证件或者其他身份证明文件的复印件或者影印件：资金账户开户、销户、变更，资金存取等。开立基金账户。代办证券账户的开户、挂失、销户或者期货客户交易编码的申请、挂失、销户。与客户签订期货经纪合同。为客户办理代理授权或者取消代理授权。转托管，指定交易、撤销指定交易。代办股份确认。交易密码挂失。修改客户身份基本信息等资料。开通网上交易、电话交易等非柜面交易方式。与客户签订融资融券等信用交易合同。办理中国人民银行和中国证券监督管理委员会确定的其他业务。', legacy_related_scenarios: ['资金账户开户', '资金账户销户', '资金账户变更', '资金存取', '基金账户开立', '证券账户代办开户', '证券账户代办挂失', '证券账户代办销户', '期货客户交易编码申请', '期货客户交易编码挂失', '期货客户交易编码销户', '签订期货经纪合同', '代理授权管理', '转托管', '指定交易', '撤销指定交易', '代办股份确认', '交易密码挂失', '修改客户身份信息', '开通非柜面交易', '签订信用交易合同'], legacy_business_categories: ['反洗钱', '证券期货基金业务', '客户身份识别']};
